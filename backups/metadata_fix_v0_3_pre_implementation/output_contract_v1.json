{
  "schema_version": "1.0.0",
  "engine_contract_version": "1.0.0",
  "required_output_files": [
    "document_record.json",
    "page_index.jsonl",
    "text_blocks.jsonl",
    "text_block_statistics.json",
    "section_candidates.jsonl",
    "section_index.jsonl",
    "section_statistics.json",
    "suspicious_sections.jsonl",
    "evidence_store.jsonl",
    "evidence_statistics.json",
    "table_index.jsonl",
    "table_cells.jsonl",
    "table_statistics.json",
    "figure_index.jsonl",
    "figure_statistics.json",
    "document_inventory.json",
    "multimodal_evidence_index.jsonl",
    "multimodal_statistics.json",
    "consistency_report.json",
    "audit_findings.jsonl",
    "document_audit_report.md",
    "quality_report.jsonl",
    "extraction_summary.json"
  ],
  "optional_output_files": [],
  "required_fields_by_file": {
    "document_record.json": ["schema_version", "document_id", "sha256", "document_path", "file_name", "page_count", "loading_status", "created_at"],
    "page_index.jsonl": ["schema_version", "page_id", "document_id", "page_number", "width", "height", "rotation", "extraction_status", "text_char_count", "has_text"],
    "text_blocks.jsonl": ["schema_version", "text_block_id", "document_id", "page_id", "page_number", "block_type", "text", "bbox", "reading_order"],
    "section_candidates.jsonl": ["schema_version", "candidate_id", "document_id", "text_block_id", "page_number", "text", "candidate_status", "block_type", "confidence"],
    "section_index.jsonl": ["schema_version", "section_id", "document_id", "section_title", "section_type", "page_start", "page_end", "start_element_id", "source_heading_block_id", "section_quality_score", "is_suspicious_section", "suspicion_reasons", "evidence_policy"],
    "suspicious_sections.jsonl": ["schema_version", "document_id", "section_id", "section_title", "section_quality_score", "evidence_policy", "suspicion_reasons", "evidence_count", "sample_evidence_quotes"],
    "evidence_store.jsonl": ["schema_version", "evidence_id", "document_id", "page_id", "page_number", "evidence_type", "quote", "bbox", "section_id", "source_element_type", "source_element_id", "evidence_policy", "review_required", "is_quarantined_evidence"],
    "table_index.jsonl": ["schema_version", "table_id", "document_id", "page_id", "page_number", "section_id", "extraction_status", "row_count", "column_count", "cell_count", "table_confidence", "review_required", "is_quarantined_table", "table_quality_flags"],
    "table_cells.jsonl": ["schema_version", "cell_id", "table_id", "document_id", "page_id", "page_number", "row_index", "column_index", "text", "bbox", "is_header_cell", "cell_confidence", "normalized_text"],
    "figure_index.jsonl": ["schema_version", "figure_id", "document_id", "page_id", "page_number", "section_id", "figure_type", "extraction_status", "figure_confidence", "review_required", "is_quarantined_figure", "figure_quality_flags"],
    "multimodal_evidence_index.jsonl": ["schema_version", "multimodal_evidence_id", "evidence_id", "document_id", "evidence_type", "source_modality", "source_element_type", "source_element_id", "evidence_policy", "review_required", "is_quarantined_evidence", "downstream_use_policy"],
    "audit_findings.jsonl": ["schema_version", "finding_id", "document_id", "severity", "category", "check_name", "status", "message", "related_file", "recommendation"],
    "quality_report.jsonl": ["schema_version", "quality_check_id", "target_type", "target_id", "check_name", "status", "severity", "message", "created_at"],
    "document_inventory.json": ["schema_version", "document_id", "pdf_path", "page_count", "pages_processed", "text_blocks_count", "sections_count", "evidence_count", "extraction_readiness_status", "generated_at"],
    "multimodal_statistics.json": ["schema_version", "document_id", "total_multimodal_evidences", "evidence_by_modality", "downstream_use_policy_distribution"],
    "consistency_report.json": ["schema_version", "document_id", "generated_at", "overall_status", "errors_count", "warnings_count", "checks_count", "findings"],
    "extraction_summary.json": ["schema_version", "engine_contract_version", "document_id", "status", "pages_processed", "text_blocks_count", "evidence_count", "errors_count", "warnings_count"]
  },
  "allowed_values_by_field": {
    "evidence_policy": ["normal", "review_required", "quarantine"],
    "downstream_use_policy": ["eligible_for_future_extraction", "review_before_extraction", "exclude_from_automatic_extraction"],
    "source_modality": ["text", "table", "figure"],
    "evidence_type": ["section_heading", "paragraph", "table", "figure", "list_item", "footnote", "caption", "unknown"],
    "table_extraction_status": ["parsed", "detected_not_parsed", "low_confidence", "empty_table", "failed"],
    "figure_extraction_status": ["detected", "low_confidence", "detected_not_interpreted", "failed"],
    "overall_status": ["pass", "warning", "fail"],
    "extraction_readiness_status": ["ready_for_experimental_extraction", "partially_ready", "not_ready"],
    "quality_status": ["pass", "warning", "fail", "info"],
    "finding_status": ["pass", "warning", "fail", "info"],
    "finding_severity": ["info", "minor", "major", "critical"]
  },
  "cross_file_invariants": [
    "evidence_id_unique",
    "evidence_store_ids_match_multimodal_evidence_index",
    "quarantine_evidence_not_eligible_for_future_extraction",
    "review_required_evidence_not_eligible_for_future_extraction",
    "table_evidence_references_existing_table_id",
    "figure_evidence_references_existing_figure_id",
    "referenced_section_id_exists_or_null",
    "no_source_pdf_or_esgfinalcorpus_modification"
  ]
}
