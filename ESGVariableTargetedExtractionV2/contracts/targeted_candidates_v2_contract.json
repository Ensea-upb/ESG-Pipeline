{
  "schema_version": "2.0.0",
  "contract_name": "targeted_candidates_v2",
  "description": "Output contract for ESGVariableTargetedExtractionV2 candidate records.",
  "required_columns": [
    "candidate_id",
    "schema_version",
    "engine",
    "target_variable",
    "indicator_family",
    "document_id",
    "company",
    "company_slug",
    "fiscal_year",
    "official_doc_type",
    "page_number",
    "source_type",
    "raw_value",
    "raw_unit",
    "quote",
    "candidate_status"
  ],
  "optional_columns": [
    "company_name",
    "final_path",
    "chunk_id",
    "evidence_id",
    "table_id",
    "figure_id",
    "crop_id",
    "normalized_value",
    "normalized_unit",
    "raw_year",
    "prepared_year",
    "retrieval_score",
    "extraction_score",
    "candidate_score",
    "rejection_reason",
    "warning_flags",
    "lineage",
    "score_reason"
  ],
  "column_types": {
    "candidate_id": "string",
    "schema_version": "string",
    "engine": "string",
    "target_variable": "string",
    "indicator_family": "string",
    "document_id": "string",
    "company": "string",
    "company_slug": "string",
    "fiscal_year": "string",
    "official_doc_type": "string",
    "page_number": "string_or_int",
    "source_type": "string",
    "raw_value": "string",
    "raw_unit": "string",
    "quote": "string",
    "candidate_status": "string"
  },
  "allowed_candidate_statuses": [
    "candidate_found",
    "needs_review",
    "rejected_structural_noise",
    "rejected_unit_mismatch",
    "rejected_no_value",
    "rejected_no_evidence",
    "rejected_low_relevance"
  ],
  "invariants": [
    "document_id must not be empty",
    "company must not be empty",
    "fiscal_year must not be empty",
    "quote must not be empty for candidate_found and needs_review",
    "raw_value must not be empty for candidate_found",
    "candidate_status must be in allowed_candidate_statuses"
  ],
  "forbidden_patterns": [
    "ISO values as raw_value (ISO 50001 -> 50001 is forbidden)",
    "Section numbers as raw_value (2.1 as raw_value without ESG context)",
    "Page numbers as raw_value",
    "Single digit footnotes as raw_value without context"
  ]
}
